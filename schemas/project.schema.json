{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture.studio/schemas/project-v1",
  "title": "Architecture Studio project (in-memory) v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "locale", "direction", "font", "folders", "documents", "links"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "direction": { "enum": ["rtl", "ltr"] },
    "font": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "folders": { "type": "array", "items": { "$ref": "#/$defs/folder" } },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
  },
  "additionalProperties": true,
  "$defs": {
    "folder": {
      "type": "object", "required": ["id", "name"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "parentId": { "type": ["string", "null"] } },
      "additionalProperties": true
    },
    "document": {
      "type": "object", "required": ["id", "type", "name", "content", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["mermaid", "bpmn", "dmn", "c4", "erd", "infrastructure", "dfd", "general"] },
        "name": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "mode": { "enum": ["native-visual", "bidirectional", "source-preview"] },
        "folderId": { "type": ["string", "null"] },
        "updatedAt": { "type": "string" }
      }, "additionalProperties": true
    },
    "link": {
      "type": "object", "required": ["id", "fromDocId", "toDocId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromDocId": { "type": "string", "minLength": 1 },
        "toDocId": { "type": "string", "minLength": 1 },
        "fromElementId": { "type": ["string", "null"] },
        "toElementId": { "type": ["string", "null"] }
      }, "additionalProperties": true
    }
  }
}
